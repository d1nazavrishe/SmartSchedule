<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Левая колонка: метка часа (например, 08:00, 09:00...) -->
    <TextView
        android:id="@+id/tvHourLabel"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="08:00"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Вертикальная направляющая линия таймлайна -->
    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="@color/field_stroke" />

    <!-- Правая колонка: карточки событий этого часа или строка свободного окна -->
    <LinearLayout
        android:id="@+id/llHourEvents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" />

</LinearLayout>
