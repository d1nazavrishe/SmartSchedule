<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:fitsSystemWindows="true"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <!-- Контейнер, в котором отображается один из трёх фрагментов (Schedule / To-Do / AI) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Тонкая разделительная линия над нижней панелью -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/field_stroke" />

    <!-- Нижняя панель навигации между тремя экранами -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
